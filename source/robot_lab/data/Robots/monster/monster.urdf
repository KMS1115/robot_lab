        </inertial>
    </link>

    <link name="wheel_FR">
        <visual>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
                <cylinder radius="0.075" length="0.02"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
                <cylinder radius="0.075" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.7"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.00113" iyy="0.00197" izz="0.00113"
                     ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!--    joint    -->
    <joint name="hip_roll_joint_FR" type="revolute">
        <parent link="base"/>
        <child link="hip_roll_motor_FR"/>
        <origin xyz="0.2765 -0.196 0.00" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-3.1416" upper="3.1416" effort="120" velocity="20"/>
