        </inertial>
    </link>

    <link name="second_link_FR">
        <visual>
            <origin xyz="0.0 -0.02 -0.265" rpy="1.57 0 0"/>
            <geometry>
                <mesh filename="meshes/WeMO_Leg_calf.dae" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 -0.035 -0.185" rpy="0 0 0"/>
